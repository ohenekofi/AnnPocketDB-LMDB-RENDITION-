# AnnPocketDb Environment Variables Example
# Copy this file to .env and configure as needed for local development.

# Used by the language bindings (Python, Dart, Node.js, Java) to locate the 
# compiled C API shared library (libannpocketdb_c) during testing and development.
# E.g., on Windows:
# ANNPOCKETDB_LIB=D:\trio\AnnPocketDb\build\Debug\annpocketdb_c.dll
# E.g., on Linux:
# ANNPOCKETDB_LIB=/path/to/AnnPocketDb/build/libannpocketdb_c.so
ANNPOCKETDB_LIB=
