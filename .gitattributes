# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for source code files
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.go text eol=lf
*.dart text eol=lf
*.js text eol=lf
*.java text eol=lf
*.sh text eol=lf
CMakeLists.txt text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote binary files
*.dll binary
*.so binary
*.dylib binary
*.exe binary
